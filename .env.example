IMAGE=codeiary-api:latest
POSTGRES_DB=codeiary
POSTGRES_USER=codeiary
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-base64-encoded-random-secret

# Local image uploads: private S3 bucket and its CloudFront HTTPS URL
MEDIA_S3_BUCKET=
MEDIA_PUBLIC_BASE_URL=https://images.example.com
AWS_REGION=ap-northeast-2
# Production reads dedicated upload credentials from SSM into a temporary env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
