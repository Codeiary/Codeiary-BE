IMAGE=codeiary-api:latest
POSTGRES_DB=codeiary
POSTGRES_USER=codeiary
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-base64-encoded-random-secret

# Profile uploads: existing private S3 bucket and its CloudFront HTTPS URL
MEDIA_S3_BUCKET=
MEDIA_PUBLIC_BASE_URL=https://img.codeiary.com
AWS_REGION=ap-northeast-2
