IMAGE=codeiary-api:latest
POSTGRES_DB=codeiary
POSTGRES_USER=codeiary
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-base64-encoded-random-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
OAUTH2_REDIRECT_HOME=http://localhost:5173/auth/callback

# local profile uses compose.local.yaml (no AWS credentials required).
# The following settings are for real AWS S3 / production.
MEDIA_S3_BUCKET=
MEDIA_PUBLIC_BASE_URL=
AWS_REGION=ap-northeast-2
# Production reads dedicated upload credentials from SSM into a temporary env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
