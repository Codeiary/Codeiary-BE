{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadCodeiaryImages",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::codeiary-media-219336314323-ap-northeast-2/images/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    }
  ]
}
