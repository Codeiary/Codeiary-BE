{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCodeiaryProductionParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-northeast-2:219336314323:parameter/codeiary/prod/*"
    },
    {
      "Sid": "DecryptCodeiaryProductionParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:ap-northeast-2:219336314323:parameter/codeiary/prod/*"
        }
      }
    }
  ]
}
